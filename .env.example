# Create with @BotFather. Never commit the real token.
BOT_TOKEN=
# MongoDB Atlas connection string; configure as GitHub Actions secret MONGODB_URI.
# Example shape only: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=master_x
LOG_LEVEL=INFO
GLOBAL_OWNER_IDS=
